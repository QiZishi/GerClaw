# PostgreSQL control-plane connection. This process is not part of the API image.
GERCLAW_EVOLUTION_DATABASE_URL=

# Public identifiers and the content-addressed, pre-reviewed evaluator image.
GERCLAW_EVOLUTION_EXPORTER_KEY_ID=api.skill-export
GERCLAW_EVOLUTION_RECIPIENT_KEY_ID=controller.skill-review
GERCLAW_EVOLUTION_ACTIVATION_KEY_ID=skill-activation-key-v1
GERCLAW_EVOLUTION_DOCKER_IMAGE_ID=sha256:
GERCLAW_EVOLUTION_ALLOWED_TOOLS=search_knowledge,search_memory,web_search

# Secret material is read from owner-only files (mode 0600), never from CLI values.
GERCLAW_EVOLUTION_EXPORTER_PRIVATE_KEY_FILE=
GERCLAW_EVOLUTION_EXPORTER_PUBLIC_KEY_FILE=
GERCLAW_EVOLUTION_RECIPIENT_PRIVATE_KEY_FILE=
GERCLAW_EVOLUTION_OWNER_BINDING_SECRET_FILE=
GERCLAW_EVOLUTION_CASE_IDENTITY_SECRET_FILE=

# Sealed evaluator verification and accountable human approval.
GERCLAW_EVOLUTION_ATTESTATION_KEY_ID=sealed-skill-key-v1
GERCLAW_EVOLUTION_ATTESTATION_SECRET_FILE=
GERCLAW_EVOLUTION_APPROVAL_KEY_ID=skill-approval-key-v1
GERCLAW_EVOLUTION_APPROVAL_PUBLIC_KEY_FILE=
GERCLAW_EVOLUTION_APPROVER_PRINCIPAL_ID=

# Final short-lived activation authorization. Public and private files must match.
GERCLAW_EVOLUTION_ACTIVATION_PRIVATE_KEY_FILE=
GERCLAW_EVOLUTION_ACTIVATION_PUBLIC_KEY_FILE=
