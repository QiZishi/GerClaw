{
  "name": "mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-root-env.mjs dev --webpack",
    "build": "node scripts/with-root-env.mjs build",
    "start": "node scripts/with-root-env.mjs start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "npm run test:layout && npm run test:composer && npm run test:message && npm run test:audio && npm run test:cga-audio && npm run test:markdown && npm run test:export && npm run test:account && npm run test:guest-access && npm run test:document && npm run test:gerclaw-proxy && npm run test:feedback && npm run test:runs && npm run test:chat && npm run test:prescription-report",
    "test:layout": "node --test src/lib/workbench-layout.test.ts",
    "test:composer": "node --test src/components/chat/composer/composer-contract.test.ts",
    "test:message": "node --test src/components/chat/message/message-feedback.test.ts",
    "test:audio": "node --test src/lib/audioPlaybackCoordinator.test.mjs src/lib/cga-audio.test.mjs src/lib/tts-text.test.mjs src/services/voice/pcm-wav.test.mjs",
    "test:cga-audio": "node scripts/verify-cga-audio-assets.mjs",
    "test:markdown": "node --test src/lib/markdown-gfm.test.ts src/lib/citation-markers.test.ts",
    "test:export": "node --test src/lib/export/template.test.mjs",
    "test:account": "node --test src/server/account-contract.test.ts",
    "test:guest-access": "node --test src/server/gerclaw-access.test.ts",
    "test:document": "node --test src/server/mineru-contract.test.ts",
    "test:gerclaw-proxy": "node --test src/server/gerclaw-api.test.ts src/services/gerclaw/capabilities.test.ts",
    "test:feedback": "node --test src/services/gerclaw/feedback.test.ts",
    "test:runs": "node --test src/services/gerclaw/run-contract.test.ts",
    "test:chat": "node --test src/services/gerclaw/chat.test.ts src/services/gerclaw/conversation-history.test.ts src/services/gerclaw/conversation-recovery.test.ts",
    "test:prescription-report": "node --test src/services/gerclaw/prescription-report.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
